// Resource Windows untuk exe rilis: ikon & info versi (dikompilasi windres, lihat Makefile).
#include <winver.h>

1 ICON "../assets/icon/tumbal.ico"

1 VERSIONINFO
FILEVERSION     1,0,1,0
PRODUCTVERSION  1,0,1,0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "CompanyName",      "Kelompok 12"
      VALUE "FileDescription",  "TUMBAL"
      VALUE "FileVersion",      "1.0.1"
      VALUE "ProductName",      "TUMBAL"
      VALUE "ProductVersion",   "1.0.1"
      VALUE "OriginalFilename", "TUMBAL.exe"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
